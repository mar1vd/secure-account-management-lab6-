PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
BASE_URL=http://localhost:3000

# Optional SMTP configuration. Without it, one-time links/codes are printed to the server console for local demo only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Secure Accounts Demo <no-reply@example.com>"

# Optional Google OAuth. Create credentials in Google Cloud Console and add http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: set this once to create the initial administrator account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
